ENABLE_MULTI_LANGUAGE=False
ENABLE_DARK_MODE=False
ENABLE_OFFLINE_MODE=False

# Performance Thresholds
MAX_REQUEST_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=5
MAX_SESSION_SIZE_KB=100
